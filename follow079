#!/bin/bash
# follow079: the audio follows the person. Whichever camera has the face
# tracker's ADMIN reticle locked on them (feeds/NAME.log, `locked=1`) is the
# room they are in, and 079's voice, the music and the microphone the
# listener hears move there:
#   desk (the inside camera): 079 on the desktop speakers (voice079_out), the
#     music player (VLC) on the default sink, the desk mic heard;
#   bedroom (the bedroom laptop's camera): 079 into o79_net, a silent sink
#     streamed to the laptop (audio-to-yg6.sh), the music into bedroom_music,
#     streamed there too (music-to-yg6.sh), the laptop's mic heard
#     (bedroom-mic-in.sh into mix_mic, which the listener reads).
# A move needs the new room's reticle locked in FOLLOW_LOCKS (3) of its last
# 5 seconds and the current room's in none of its last FOLLOW_AWAY (20) s:
# a face flickering on the bedroom camera, or the person looking away from
# the desk, moves nothing. With the person in no camera, nothing moves.
#   follow079 start | stop | status        (log: ~/.cache/voice-079/follow.log)
set -u
here="$(dirname "$(readlink -f "$0")")"
rt="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/speak-079"
feeds="${CAM079_FEEDS:-$HOME/.local/share/phi-stream/dev/feeds}"
log="$HOME/.cache/voice-079/follow.log"
pidf="$rt/follow079.pid"
st="$here/state079"
LOCKS=${FOLLOW_LOCKS:-3} AWAY=${FOLLOW_AWAY:-20}
mkdir -p "$rt" "$(dirname "$log")"
say() { printf '%s %s\n' "$(date '+%F %T')" "$*" >> "$log"; }

# Seconds of the last WINDOW in which CAM's reticle was locked (its log, one
# line a second; nothing if the camera is not reporting).
locked_in() {   # CAM WINDOW
    local now; now=$(date +%s%6N)
    tail -n 60 "$feeds/$1.log" 2>/dev/null | awk -v now="$now" -v w="$2" '
        { t = substr($1, 3) + 0 } t >= now - w * 1000000 && /locked=1/ { n++ } END { print n + 0 }'
}

# The bedroom's microphone stream and the desk's, muted or not, into mix_mic.
mics() {   # desk|bedroom
    local d=1 b=0
    [ "$1" = desk ] && { d=0; b=1; }
    pactl set-source-mute voice079_mic_nr "$d" 2>/dev/null
    pactl list sink-inputs 2>/dev/null | awk '/^Sink Input #/{id=substr($3,2)} /application.name = "bedroom-mic"/{print id}' |
        while read -r i; do pactl set-sink-input-mute "$i" "$b"; done
}

apply() {   # desk|bedroom
    if [ "$1" = bedroom ]; then
        echo o79_net > "$rt/playsink"
    else
        rm -f "$rt/playsink"
    fi
    echo "$1" > "$rt/music_room"
    mics "$1"
    echo "$1" > "$rt/room"
    say "room: $1"
}

case "${1:-}" in
    stop)
        [ -f "$pidf" ] && kill "$(cat "$pidf")" 2>/dev/null
        rm -f "$pidf"
        apply desk
        "$here/bedroom-mic-in.sh" stop > /dev/null
        [ -f "$HOME/.cache/voice-079/yg6-audio.pid" ] && kill "$(cat "$HOME/.cache/voice-079/yg6-audio.pid")" 2>/dev/null
        pkill -f 'parec --device=o79_net[.]monitor'
        pactl set-source-mute voice079_mic_nr 0 2>/dev/null
        # The listener back on the desk alone.
        "$here/voice079" stop > /dev/null; "$here/voice079" start --wake > /dev/null
        "$st" set follow off
        echo "follow079: off; everything on the desk"
        exit 0
        ;;
    status)
        echo "room: $(cat "$rt/room" 2>/dev/null || echo none)"
        for c in inside bedroom; do echo "  $c locked $(locked_in "$c" 5)/5 s"; done
        exit 0
        ;;
    _loop)
        # Where it starts: the room last kept, else the camera that saw the
        # person locked most recently (the last hour of their logs).
        last_lock() { tail -n 3600 "$feeds/$1.log" 2>/dev/null | grep 'locked=1' | tail -n 1 | cut -d' ' -f1 | cut -c3-; }
        room=$(cat "$rt/room" 2>/dev/null)
        if [ -z "$room" ]; then
            if [ "$(last_lock bedroom || true)" \> "$(last_lock inside || true)" ]; then room=bedroom; else room=desk; fi
        fi
        apply "$room"
        while :; do
            sleep 2
            if [ "$room" = desk ]; then mine=inside; other=bedroom; to=bedroom
            else mine=bedroom; other=inside; to=desk; fi
            if [ "$(locked_in "$other" 5)" -ge "$LOCKS" ] && [ "$(locked_in "$mine" "$AWAY")" -eq 0 ]; then
                room=$to
                apply "$room"
            fi
            # The bedroom stream reconnects under a new id: its mute kept.
            mics "$room"
        done
        ;;
    start) ;;
    *) echo "follow079 start | stop | status" >&2; exit 1 ;;
esac

if [ -f "$pidf" ] && kill -0 "$(cat "$pidf")" 2>/dev/null; then echo "follow079: already on"; exit 0; fi
"$st" set follow on
# The bedroom's three links, each reconnecting on its own.
pactl list short sinks | grep -q o79_net ||
    pactl load-module module-null-sink sink_name=o79_net sink_properties=device.description=079-to-bedroom > /dev/null
pgrep -f 'parec --device=o79_net[.]monitor' > /dev/null ||
    VOICE079_OUT_MONITOR=o79_net.monitor setsid "$here/audio-to-yg6.sh" > "$HOME/.cache/voice-079/yg6-audio.log" 2>&1 < /dev/null &
pgrep -f 'parec --device=bedroom_music[.]monitor' > /dev/null ||
    setsid "$here/music-to-yg6.sh" > "$HOME/.cache/voice-079/yg6-music.log" 2>&1 < /dev/null &
pgrep -f 'pacat --playback --device=mix_mi[c]' > /dev/null ||
    setsid "$here/bedroom-mic-in.sh" > "$HOME/.cache/voice-079/yg6-mic.log" 2>&1 < /dev/null &
sleep 3
# The listener on the two rooms' mix (one of the two muted at a time).
if ! grep -aq 'listening through mix_mic.monitor' <(tail -n 5 "$HOME/.local/share/speak-079/listen.log" 2>/dev/null); then
    "$here/voice079" stop > /dev/null
    VOICE079_SRC=mix_mic.monitor "$here/voice079" start --wake > /dev/null
fi
setsid bash -c '
    echo $$ > "'"$pidf"'"
    exec "'"$0"'" _loop' > /dev/null 2>&1 < /dev/null &
echo "follow079: on (desk and bedroom), log $log"
exit 0
